// Pubblicazione su Cloudflare (Workers con file statici): l'app web esportata da Expo.
// Build: npx expo export -p web  →  cartella dist
{
  "name": "mi-conviene",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
