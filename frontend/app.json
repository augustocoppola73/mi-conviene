{
  "expo": {
    "name": "Mi Conviene",
    "slug": "mi-conviene",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miconviene",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F6B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.augustocoppola.miconviene",
      "versionCode": 7,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F6B4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Conviene usa la tua posizione per trovare i supermercati vicino a te e calcolare il costo del viaggio."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mi Conviene usa la fotocamera per leggere lo scontrino e verificare la spesa.",
          "photosPermission": "Mi Conviene apre la foto dello scontrino per verificare la spesa."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4F6B4A",
          "defaultChannel": "famiglia"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ListaGrande",
              "label": "Lista della spesa",
              "description": "La lista di casa e la spesa in corso, con + per aggiungere",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-grande.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ListaPiccolo",
              "label": "Lista: numero e +",
              "description": "Quanti prodotti ci sono in lista e + per aggiungere",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/images/widget-piccolo.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": "3",
    "updates": {
      "url": "https://mi-conviene.augustocoppola.workers.dev/api/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": { "keyid": "main", "alg": "rsa-v1_5-sha256" }
    }
  }
}
